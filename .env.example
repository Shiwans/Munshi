# Gemini API key from https://aistudio.google.com/apikey  (Gemma 4 runs through the Gemini API)
GEMINI_API_KEY=
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# gemma (default) | local  — local = LM Studio OpenAI-compatible server
MUNSHI_PROVIDER=gemma
GEMMA_MODEL=gemma-4-26b-a4b-it
LMSTUDIO_URL=http://localhost:1234/v1
LOCAL_MODEL=qwen/qwen3.6-35b-a3b
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# second copy of every khata, one snapshot per trader per day (default: ./backups)
MUNSHI_BACKUP_DIR=
